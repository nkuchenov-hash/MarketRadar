# For PERSONAL local testing use Codex CLI + ChatGPT sign-in.
# For production set MARKETRADAR_AI_PROVIDER=api and configure a server-owned key.
MARKETRADAR_AI_PROVIDER=codex
# Codex CLI model pinned independently of the default in your personal config.toml.
MARKETRADAR_CODEX_MODEL=gpt-6.1-sol
OPENAI_API_KEY=
MARKETRADAR_MODEL=gpt-4.1-mini
APP_ORIGIN=http://127.0.0.1:8765
COOKIE_SECURE=false
DB_PATH=./data/marketradar.sqlite3
FREE_SEARCHES=3
DEEP_CARD_LIMIT=18
FAST_CARD_LIMIT=7
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Optional HTTPS domain in production, configured separately from the app.
PAID_SEARCHES_PER_MONTH=100
