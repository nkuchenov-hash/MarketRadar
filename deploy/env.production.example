# This file documents configuration; never commit the real .env.production.
# Run deploy/bootstrap.sh to generate a private access key automatically.
MARKETRADAR_DOMAIN=example.yourdomain.ru
MARKETRADAR_MOBILE_ACCESS_KEY=replace-with-cryptographically-random-32-byte-token
CLOUD_BROWSER_ENABLED=true
COOKIE_SECURE=true
DB_PATH=/app/data/marketradar.sqlite3
MARKETRADAR_AI_PROVIDER=api

# Optional: separate server-side Chromium network egress for a storefront.
# Required only when a marketplace blocks the VPS public IP. Do not commit
# a real endpoint or credentials. A proxy alone does not guarantee access.
# MARKETRADAR_OZON_PROXY_SERVER=http://proxy-host:port
# MARKETRADAR_OZON_PROXY_USERNAME=your-username
# MARKETRADAR_OZON_PROXY_PASSWORD=your-private-password

# Optional: Ozon can use a separate live Chromium worker reachable by WSS,
# with independently verified storefront access. Keep this URL and any token
# private on the VPS; do not commit a real worker endpoint.
# MARKETRADAR_OZON_CHROMIUM_CDP_URL=wss://your-ozon-browser-host.example/devtools/browser/...
# Validate from the actual backend with:
#   CLOUD_BROWSER_ENABLED=true python -m server.probe_ozon
# A green unit test or backend health response is NOT Ozon access validation.
