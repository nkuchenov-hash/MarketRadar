# ONLY on the cloud server. Never place secrets in browser extension or git.
MARKETRADAR_AI_PROVIDER=api
OPENAI_API_KEY=
MARKETRADAR_MODEL=gpt-4.1-mini
APP_ORIGIN=https://your-market-radar-domain.example
COOKIE_SECURE=true
DB_PATH=/app/data/marketradar.sqlite3
FREE_SEARCHES=3
PAID_SEARCHES_PER_MONTH=100
